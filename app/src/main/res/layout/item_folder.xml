<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="#0B0B0B"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">
    <FrameLayout
        android:layout_width="108dp"
        android:layout_height="64dp">
        <ImageView
            android:id="@+id/ivFolderThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#202A40"
            android:scaleType="centerCrop"
            android:src="@drawable/thumb_placeholder"
            android:contentDescription="Folder thumbnail" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvFolderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="serif"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/tvFolderMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#A5A5A5"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/tvFolderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#BDBDBD"
            android:textSize="10sp" />
    </LinearLayout>
    <Button
        android:id="@+id/btnFolderOpen"
        android:layout_width="70dp"
        android:layout_height="34dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/play_button_bg"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="Open"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
