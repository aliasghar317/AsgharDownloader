<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="18dp">

    <com.asghar.downloader.views.GradientTextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="0dp"
        android:layout_height="105dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/edittext_bg"
        android:gravity="top|start"
        android:hint="Paste video link here..."
        android:inputType="textUri|textMultiLine"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777F95"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <Button
        android:id="@+id/btnDownload"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/premium_button_bg"
        android:text="DOWNLOAD"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etUrl" />

    <TextView
        android:id="@+id/btnYoutubeSignIn"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/edittext_bg"
        android:gravity="center"
        android:padding="8dp"
        android:text="Sign in to YouTube (fixes 'bot' errors)"
        android:textColor="#8B5CF6"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDownload" />

    <TextView
        android:id="@+id/tvQualityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Select quality"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDownload" />

    <RadioGroup
        android:id="@+id/rgQuality"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQualityLabel">
        <RadioButton android:id="@+id/rb4k" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="4k" android:text="4K Video" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rb1080p" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="1080p" android:text="1080p HD" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rb720p" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:checked="true" android:tag="720p" android:text="720p HD" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rb480p" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="480p" android:text="480p" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rb360p" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="360p" android:text="360p" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rb240p" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="240p" android:text="240p" android:textColor="#FFFFFF" />
        <RadioButton android:id="@+id/rbMp3" android:layout_width="match_parent" android:layout_height="36dp" android:buttonTint="#8B5CF6" android:tag="mp3" android:text="MP3 Audio" android:textColor="#FFFFFF" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvEngineStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        android:text="Preparing downloader…"
        android:textColor="#7C8AA5"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/btnWhatsapp" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/whatsapp_button_bg" android:contentDescription="WhatsApp" android:padding="13dp" android:src="@drawable/ic_whatsapp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/btnDownloads" android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/downloads_button_bg" android:contentDescription="Download list" android:padding="15dp" android:src="@drawable/ic_downloads" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloads" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/btnMovies" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/movies_button_bg" android:contentDescription="Movies" android:padding="13dp" android:src="@drawable/ic_movies" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Movies" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageButton android:id="@+id/btnTelegram" android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/telegram_button_bg" android:contentDescription="Telegram channel" android:padding="13dp" android:src="@drawable/ic_telegram" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Telegram" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
